# ---- Database (Docker Compose) ----
POSTGRES_DB=grievance360
POSTGRES_USER=grievance360
POSTGRES_PASSWORD=change-me-local-db-password

# ---- Backend ----
# Generate with: openssl rand -base64 48   (must be >= 32 bytes)
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-bytes
JWT_EXPIRY_MINUTES=60
# Comma separated, explicit origins only
CORS_ALLOWED_ORIGINS=http://localhost:5173
# dev = local defaults; add ",demo" to load demo data (development only)
SPRING_PROFILES_ACTIVE=dev
# One-time admin bootstrap: created only if no ADMIN exists. Remove after first start.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=System Administrator

# ---- Frontend (build-time, public) ----
VITE_API_BASE_URL=http://localhost:8080/api/v1
